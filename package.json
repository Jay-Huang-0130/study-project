{
  "name": "study-project",
  "version": "0.9.3",
  "private": true,
  "description": "個人 PDF 讀書導師",
  "type": "module",
  "overrides": {
    "katex": "$katex",
    "global-agent": "^4.1.3"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --win nsis portable",
    "check": "npm run test && npm run build",
    "check:codex": "tsx scripts/check-codex.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@napi-rs/canvas": "^0.1.80",
    "@openai/codex": "^0.163.0",
    "@xyflow/react": "^12.12.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "tw.studyproject.desktop",
    "productName": "Study Project",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/pdf-worker.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**",
      "node_modules/@openai/**",
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Study-Project-${version}-Windows.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jay-Huang-0130",
        "repo": "study-project",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "Study-Project-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
